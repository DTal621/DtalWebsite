---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import { profile } from '../data/profile';
---

<BaseLayout title={profile.name}>
  <Nav />

  <!-- Minimal placeholder — home redesign in progress -->
  <section class="max-w-4xl mx-auto px-4 pt-32 pb-24">
    <h1 class="font-display text-4xl sm:text-5xl font-medium text-text tracking-tight leading-tight">
      {profile.name}
    </h1>
    <p class="font-sans mt-4 text-lg sm:text-xl text-muted max-w-2xl leading-relaxed">
      {profile.tagline}
    </p>
  </section>

</BaseLayout>
