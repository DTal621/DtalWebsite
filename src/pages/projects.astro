---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import PageSection from '../components/PageSection.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';

const projects = profile.projects;
---

<BaseLayout title={`Projects — ${profile.name}`}>
  <Nav />

  <!-- ── Hero (above fold — not animated) ─────────────────────────────── -->
  <section class="max-w-4xl mx-auto px-4 pt-20 pb-16">
    <h1 class="font-display text-4xl sm:text-5xl font-medium text-text tracking-tight leading-tight">
      Projects
    </h1>
    <p class="font-sans mt-4 text-lg text-muted max-w-2xl leading-relaxed">
      Things I've built, shipped, and tinkered with.
    </p>
  </section>

  <!-- ── Projects ──────────────────────────────────────────────────────── -->
  <PageSection heading="selected work" first>
    {projects.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {projects.map((project, i) => (
          <div data-fade data-delay={i * 60}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    ) : (
      <p class="font-mono text-xs text-muted">projects coming soon.</p>
    )}
  </PageSection>

</BaseLayout>

<script>
  import { initFadeIn } from '../scripts/motion';
  initFadeIn();
</script>
