---
import type { Role } from '../data/profile';
import ArticleCarousel from './ArticleCarousel.astro';

interface Props {
  role: Role;
}

const { role } = Astro.props;

// Media sections ("Talks & Media") always come first, before other sections.
const isMedia = (label: string) => /talk|media/i.test(label);
const sections = [...(role.articleSections ?? [])].sort(
  (a, b) => Number(isMedia(b.label)) - Number(isMedia(a.label))
);
---

<article class="bg-surface border border-border rounded-xl p-6">

  <!-- Title row: role title left, period right -->
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-display text-base font-medium text-text">
      {role.title}
    </h3>
    <span class="font-mono text-xs text-muted shrink-0">
      {role.period}
    </span>
  </div>

  <!-- Org · location -->
  <p class="font-mono text-xs lowercase tracking-wide text-muted mt-1">
    {role.org} &middot; {role.location}
  </p>

  <!-- By the numbers -->
  {role.numbers && role.numbers.length > 0 && (
    <div class="mt-5 grid grid-cols-3 gap-4">
      {role.numbers.map(n => (
        <div class="flex flex-col gap-1">
          <span
            class="font-mono text-xl sm:text-2xl font-medium text-accent leading-none"
            data-count-up={n.value}
          >
            {n.value}
          </span>
          <span class="font-mono text-[0.7rem] leading-snug lowercase text-muted">
            {n.label}
          </span>
        </div>
      ))}
    </div>
  )}

  <!-- Achievements -->
  <ul class="mt-4 space-y-2">
    {role.achievements.map(a => (
      <li class="flex gap-2.5">
        <span class="mt-[0.3rem] text-accent select-none shrink-0 leading-none" aria-hidden="true">·</span>
        <span class="font-sans text-sm text-text leading-relaxed">{a.text}</span>
      </li>
    ))}
  </ul>

  <!-- Labeled article/media sections — media first; one card visible, slider for the rest -->
  {sections.map(section => (
    section.articles.length > 0 && (
      <div class="mt-6 pt-5 border-t border-border">
        <h4 class="font-mono text-xs lowercase tracking-widest text-muted mb-4">
          {section.label}
        </h4>
        <ArticleCarousel articles={section.articles} />
      </div>
    )
  ))}

</article>

<script>
  import { initCountUp } from '../scripts/motion';
  initCountUp();
</script>
