---
import type { Project } from '../data/profile';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a
  href={project.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group block bg-surface border border-border rounded-xl p-6 hover:border-accent motion-safe:transition motion-safe:duration-200 motion-safe:hover:-translate-y-0.5"
>
  <!-- Name + external icon -->
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-display text-base font-medium text-text group-hover:text-accent motion-safe:transition-colors leading-snug">
      {project.name}
    </h3>
    <svg
      width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      class="shrink-0 mt-0.5 text-muted group-hover:text-accent motion-safe:transition-colors"
      aria-hidden="true"
    >
      <path d="M7 17L17 7M17 7H7M17 7V17"/>
    </svg>
  </div>

  <!-- Description -->
  <p class="font-sans text-sm text-muted leading-relaxed mt-3">
    {project.description}
  </p>

  <!-- Tags -->
  {project.tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-4">
      {project.tags.map(tag => (
        <span class="font-mono text-xs lowercase px-2 py-0.5 rounded border border-border text-muted">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
