---
import type { RoleArticle } from '../data/profile';
import ArticleCard from './ArticleCard.astro';

interface Props {
  articles: RoleArticle[];
}

const { articles } = Astro.props;
const multiple = articles.length > 1;
---

<div class="relative" data-carousel>
  <!-- Track: one card per view, horizontal scroll-snap -->
  <div
    data-carousel-track
    class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
  >
    {articles.map(article => (
      <div class="snap-start shrink-0 basis-full">
        <ArticleCard article={article} />
      </div>
    ))}
  </div>

  {multiple && (
    <div class="mt-3 flex items-center justify-between gap-4">
      <!-- Position dots -->
      <div class="flex items-center gap-1.5" data-carousel-dots>
        {articles.map((_, i) => (
          <button
            type="button"
            data-dot={i}
            aria-label={`Go to item ${i + 1}`}
            class="h-1.5 w-1.5 rounded-full bg-border motion-safe:transition-colors"
          />
        ))}
      </div>

      <!-- Prev / next arrows -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-prev
          aria-label="Previous"
          class="p-1.5 rounded-md border border-border text-muted hover:text-accent hover:border-accent motion-safe:transition-colors disabled:opacity-40 disabled:hover:text-muted disabled:hover:border-border"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>
        <button
          type="button"
          data-next
          aria-label="Next"
          class="p-1.5 rounded-md border border-border text-muted hover:text-accent hover:border-accent motion-safe:transition-colors disabled:opacity-40 disabled:hover:text-muted disabled:hover:border-border"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
  )}
</div>

<script>
  function initCarousels() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      const track = root.querySelector<HTMLElement>('[data-carousel-track]');
      if (!track || track.dataset.wired === 'true') return;
      track.dataset.wired = 'true';

      const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-next]');
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));

      const items = () => Array.from(track.children) as HTMLElement[];

      const currentIndex = () => {
        const els = items();
        let idx = 0;
        let best = Infinity;
        els.forEach((el, i) => {
          const d = Math.abs(el.offsetLeft - track.scrollLeft);
          if (d < best) { best = d; idx = i; }
        });
        return idx;
      };

      const go = (i: number) => {
        const els = items();
        const clamped = Math.max(0, Math.min(i, els.length - 1));
        track.scrollTo({ left: els[clamped].offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
      };

      const update = () => {
        const i = currentIndex();
        const count = items().length;
        dots.forEach((d, di) => {
          const active = di === i;
          d.classList.toggle('bg-accent', active);
          d.classList.toggle('bg-border', !active);
        });
        if (prev) prev.disabled = i <= 0;
        if (next) next.disabled = i >= count - 1;
      };

      prev?.addEventListener('click', () => go(currentIndex() - 1));
      next?.addEventListener('click', () => go(currentIndex() + 1));
      dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.dot))));

      let raf = 0;
      track.addEventListener('scroll', () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(update);
      });

      update();
    });
  }

  initCarousels();
</script>
